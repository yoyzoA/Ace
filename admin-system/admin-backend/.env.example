# Used when running the admin server on its own during development.
# The installed app asks for these on first run and keeps them on that PC only.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/ace
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=use-a-long-unique-password
# 32+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
